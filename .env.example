# Server
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_API_BASE_URL=/api

# MongoDB Atlas - replace before deployment
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGODB_DB=mern_admin

# JWT - generate a long random secret for each environment
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_COOKIE_NAME=layla_session
JWT_EXPIRES_IN_SECONDS=28800

# Staff account emails and initial passwords - change before public deployment
MANAGER_EMAIL=manager@atelier.pk
RECEPTIONIST_EMAIL=reception@atelier.pk
SEED_MANAGER_PASSWORD=@manager123
SEED_RECEPTIONIST_PASSWORD=@receptionist123
PASSWORD_RESET_TTL_MINUTES=30

# WhatsApp click-to-chat (no Meta Developer account or API token required)
# Digits only, including country code. All inquiry links open a chat to this number.
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=923337109448
# Used for client numbers entered without an international country code.
NEXT_PUBLIC_WHATSAPP_DEFAULT_COUNTRY_CODE=974

# Gmail SMTP email delivery
# Enable 2-Step Verification on the Gmail account and create a Google App Password.
# Use the App Password here; never commit the real value.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-google-app-password
EMAIL_FROM_NAME=LAYLA Atelier
